    <script>
      function headingFromHash(hash) {
        if (!hash) return null;
        let id = hash.charAt(0) === "#" ? hash.slice(1) : hash;
        try {
          id = decodeURIComponent(id);
        } catch (e) {
          // keep the raw id
        }
        const el = document.getElementById(id);
        if (!el) return null;
        if (/^H[1-6]$/.test(el.tagName)) return el;
        return el.closest("h1, h2, h3, h4, h5, h6") || el;
      }

      function ensureScrollRoom(el) {
        var spacer = document.getElementById("dg-hash-spacer");
        if (!spacer) {
          spacer = document.createElement("div");
          spacer.id = "dg-hash-spacer";
          spacer.setAttribute("aria-hidden", "true");
          document.body.appendChild(spacer);
        }
        spacer.style.height = "0px";
        var margin = parseFloat(getComputedStyle(el).scrollMarginTop) || 0;
        var desired = el.getBoundingClientRect().top + window.scrollY - margin;
        if (desired < 0) desired = 0;
        var maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (desired > maxScroll + 1) {
          spacer.style.height = Math.ceil(desired - maxScroll) + "px";
        }
      }

      function flashHeading(el) {
        if (!el) return;
        el.classList.add("referred");
        ensureScrollRoom(el);
        var root = document.documentElement;
        var previous = root.style.scrollBehavior;
        root.style.scrollBehavior = "auto";
        el.scrollIntoView({ block: "start", behavior: "instant" });
        root.style.scrollBehavior = previous;
        el.classList.remove("heading-flash");
        void el.offsetWidth;
        el.classList.add("heading-flash");
        clearTimeout(el._headingFlashTimer);
        el._headingFlashTimer = setTimeout(function () {
          el.classList.remove("heading-flash");
        }, 1000);
      }

      function focusHashedHeading() {
        flashHeading(headingFromHash(window.location.hash));
      }

      if (window.location.hash) {
        focusHashedHeading();
        window.addEventListener("load", focusHashedHeading);
      }
      window.addEventListener("hashchange", function (evt) {
        const oldParts = evt.oldURL.split("#");
        if (oldParts[1]) {
          const previous = headingFromHash("#" + oldParts[1]);
          if (previous) previous.classList.remove("referred");
        }
        focusHashedHeading();
      }, false);
      const url_parts = window.location.href.split("#")
      const url = url_parts[0];
      const referrence = url_parts[1];
      document.querySelectorAll(".cm-s-obsidian > *[id]").forEach(function (el) {
        el.ondblclick = function(evt) {
          const ref_url = url + '#' + evt.target.id
          navigator.clipboard.writeText(ref_url);
      }
      });

      
    </script>