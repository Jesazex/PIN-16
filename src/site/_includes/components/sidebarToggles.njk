{#- Fixed corner icon-only toggles + desktop hover-peek + mobile tap-close. -#}
<button type="button"
        class="panel-edge-toggle panel-edge-toggle-left"
        data-panel-toggle="left"
        aria-label="Toggle file list"
        title="Toggle file list">
      <i data-lucide="chevron-right" class="panel-icon panel-icon-closed" aria-hidden="true"></i>
      <i data-lucide="chevron-left" class="panel-icon panel-icon-open" aria-hidden="true"></i>
</button>
<button type="button"
        class="panel-edge-toggle panel-edge-toggle-right"
        data-panel-toggle="right"
        aria-label="Toggle outline"
        title="Toggle outline">
      <i data-lucide="chevron-left" class="panel-icon panel-icon-closed" aria-hidden="true"></i>
      <i data-lucide="chevron-right" class="panel-icon panel-icon-open" aria-hidden="true"></i>
</button>

<script>
(function () {
      const LEFT_KEY = 'dg-left-panel-collapsed';
      const RIGHT_KEY = 'dg-right-panel-collapsed';
      const COMPACT_MQ = window.matchMedia('(max-width: 1000px)');
      const DESKTOP_MQ = window.matchMedia('(min-width: 1001px)');

      const hoverPeek = { left: false, right: false };
      const leaveTimers = { left: null, right: null };
      let iconsReady = false;

      function isCompact() {
            return COMPACT_MQ.matches;
      }

      function isDesktop() {
            return DESKTOP_MQ.matches;
      }

      function storageKey(side) {
            return side === 'left' ? LEFT_KEY : RIGHT_KEY;
      }

      function readCollapsed(key) {
            try {
                  const value = sessionStorage.getItem(key);
                  if (value === null) {
                        return isCompact();
                  }
                  return value === '1';
            } catch {
                  return isCompact();
            }
      }

      function writeCollapsed(key, value) {
            try {
                  sessionStorage.setItem(key, value ? '1' : '0');
            } catch {
                  // ignore
            }
      }

      function pinnedCollapsed(side) {
            return readCollapsed(storageKey(side));
      }

      function toggleBtn(side) {
            return document.querySelector(`.panel-edge-toggle[data-panel-toggle="${side}"]`);
      }

      function panelEl(side) {
            return side === 'left'
                  ? document.querySelector('.filetree-wrapper')
                  : document.querySelector('.sidebar#page-panel');
      }

      function ensureIcons() {
            if (iconsReady) return;
            if (window.lucide && typeof window.lucide.createIcons === 'function') {
                  document.querySelectorAll('.panel-edge-toggle').forEach((btn) => {
                        window.lucide.createIcons({
                              nodes: [btn],
                              attrs: { class: ['svg-icon'] },
                        });
                  });
                  iconsReady = true;
            }
      }

      function applyState() {
            let leftPinned = pinnedCollapsed('left');
            let rightPinned = pinnedCollapsed('right');

            if (isCompact() && !leftPinned && !rightPinned) {
                  rightPinned = true;
                  writeCollapsed(RIGHT_KEY, true);
            }

            const leftPeek = isDesktop() && hoverPeek.left;
            const rightPeek = isDesktop() && hoverPeek.right;
            const root = document.documentElement;

            root.classList.toggle('left-panel-collapsed', leftPinned);
            root.classList.toggle('right-panel-collapsed', rightPinned);
            root.classList.toggle('left-panel-peek', leftPeek && leftPinned);
            root.classList.toggle('right-panel-peek', rightPeek && rightPinned);
            root.classList.toggle('compact-panels', isCompact());
            root.classList.add('dg-panel-boot');

            document.body.classList.toggle('left-panel-collapsed', leftPinned);
            document.body.classList.toggle('right-panel-collapsed', rightPinned);
            document.body.classList.toggle('left-panel-peek', leftPeek && leftPinned);
            document.body.classList.toggle('right-panel-peek', rightPeek && rightPinned);
            document.body.classList.toggle('compact-panels', isCompact());

            // Icons are swapped via CSS; only create lucide SVGs once.
            ensureIcons();
      }

      function setCollapsed(side, collapsed) {
            if (isCompact() && !collapsed) {
                  writeCollapsed(LEFT_KEY, side !== 'left');
                  writeCollapsed(RIGHT_KEY, side !== 'right');
            } else {
                  writeCollapsed(storageKey(side), collapsed);
            }
            hoverPeek[side] = false;
            applyState();
      }

      function setHoverPeek(side, on) {
            if (!isDesktop()) {
                  hoverPeek.left = false;
                  hoverPeek.right = false;
                  return;
            }
            if (on && !pinnedCollapsed(side)) {
                  hoverPeek[side] = false;
                  applyState();
                  return;
            }
            hoverPeek[side] = !!on;
            applyState();
      }

      function relatedStillInside(side, related) {
            if (!related || !(related instanceof Node)) return false;
            const panel = panelEl(side);
            const btn = toggleBtn(side);
            return (panel && panel.contains(related)) || (btn && btn.contains(related));
      }

      function bindHover(side) {
            const onEnter = () => {
                  if (!isDesktop()) return;
                  clearTimeout(leaveTimers[side]);
                  leaveTimers[side] = null;
                  setHoverPeek(side, true);
            };
            const onLeave = (evt) => {
                  if (!isDesktop()) return;
                  if (relatedStillInside(side, evt.relatedTarget)) return;
                  clearTimeout(leaveTimers[side]);
                  leaveTimers[side] = setTimeout(() => {
                        setHoverPeek(side, false);
                  }, 80);
            };

            const btn = toggleBtn(side);
            const panel = panelEl(side);
            if (btn) {
                  btn.addEventListener('pointerenter', onEnter);
                  btn.addEventListener('pointerleave', onLeave);
            }
            if (panel) {
                  panel.addEventListener('pointerenter', onEnter);
                  panel.addEventListener('pointerleave', onLeave);
            }
      }

      document.addEventListener('click', (evt) => {
            const btn = evt.target.closest('[data-panel-toggle].panel-edge-toggle');
            if (btn) {
                  const side = btn.getAttribute('data-panel-toggle');
                  if (side !== 'left' && side !== 'right') return;
                  evt.preventDefault();
                  evt.stopPropagation();
                  setCollapsed(side, !pinnedCollapsed(side));
                  return;
            }

            if (!isCompact()) return;

            const leftOpen = !pinnedCollapsed('left');
            const rightOpen = !pinnedCollapsed('right');
            if (!leftOpen && !rightOpen) return;

            const inLeft = evt.target.closest('.filetree-wrapper');
            const inRight = evt.target.closest('.sidebar#page-panel');
            const onEdge = evt.target.closest('.panel-edge-toggle');

            if (!inLeft && !inRight && !onEdge) {
                  if (leftOpen) setCollapsed('left', true);
                  if (rightOpen) setCollapsed('right', true);
                  return;
            }

            if (inLeft && leftOpen) {
                  const item = evt.target.closest('a.notelink, a.filename, .notelink a, .deadline-link');
                  if (item) setCollapsed('left', true);
                  return;
            }
            if (inRight && rightOpen) {
                  const item = evt.target.closest('.toc-container a, .toc a, .backlink-card a, a.backlink');
                  if (item) setCollapsed('right', true);
            }
      }, true);

      function boot() {
            bindHover('left');
            bindHover('right');
            applyState();
            // Lucide may load after DOMContentLoaded.
            if (!iconsReady) {
                  const t = setInterval(() => {
                        ensureIcons();
                        if (iconsReady) clearInterval(t);
                  }, 50);
                  setTimeout(() => clearInterval(t), 3000);
            }
      }

      COMPACT_MQ.addEventListener('change', () => {
            hoverPeek.left = false;
            hoverPeek.right = false;
            applyState();
      });
      DESKTOP_MQ.addEventListener('change', () => {
            hoverPeek.left = false;
            hoverPeek.right = false;
            applyState();
      });

      if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
      } else {
            boot();
      }
})();
</script>
