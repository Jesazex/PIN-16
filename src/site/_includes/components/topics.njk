{#- Full-height list of note topics (Конспекты + root notes) for the right sidebar. -#}
{% macro topicLink(fileOrFolder) %}
  {% if fileOrFolder.isNote and not fileOrFolder.hide %}
    <li class="topics-item{{ ' is-active' if fileOrFolder.permalink === permalink }}">
      <a href="{{ fileOrFolder.permalink }}" data-note-icon="{{ fileOrFolder.noteIcon }}">{{ fileOrFolder.name }}</a>
    </li>
  {% elif fileOrFolder.isFolder %}
    {% for childName, child in fileOrFolder %}
      {% if child.isNote or child.isFolder %}
        {{ topicLink(child) }}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endmacro %}

<nav class="topics" aria-label="Темы">
  <div class="topics-title">Темы</div>
  <ul class="topics-list">
    {%- for name, node in filetree -%}
      {% if node.isFolder and name == "Конспекты" %}
        {{ topicLink(node) }}
      {% elif node.isNote and not node.hide %}
        {{ topicLink(node) }}
      {% endif %}
    {%- endfor -%}
  </ul>
</nav>
